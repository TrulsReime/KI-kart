@model TakkViewModel
@{
    ViewData["Fane"] = "meldinn";
    ViewData["Title"] = "Takk";
}
<section class="thanks">
    <span class="tick">@Ikoner.Ikon("check", 30)</span>
    <h2>@(Model.Oppdatering ? "Takk for oppdateringen!" : "Takk for at du delte prosjektet!")</h2>
    <p>@(Model.Oppdatering
        ? "Oppdateringen vises med dagens dato så snart DigiAgder har sett over den."
        : "DigiAgder ser over innmeldingen, vanligvis innen to arbeidsdager. Deretter blir prosjektet synlig i kartet og under «Sist oppdatert».")</p>
    <div class="thanks-card"><partial name="_ProsjektKort" model="Model.Prosjekt" /></div>
    <ol class="nextsteps">
        <li><strong>Synlig for alle kommunene. </strong>Andre kan finne prosjektet og ta kontakt med deg.</li>
        <li><strong>Du er prosjekteier. </strong>Du kan oppdatere prosjektet når som helst, og du får beskjed når noen vil samarbeide.</li>
        <li><strong>Påminnelse etter 11 måneder. </strong>Bekrefter du ikke at prosjektet er oppdatert innen 12 måneder, blir det inaktivt og skjules fra oversikten til du bekrefter det igjen.</li>
    </ol>
    <div class="stepnav" style="justify-content:center">
        <a class="btn primary big" asp-controller="MeldInn" asp-action="Index">Meld inn et prosjekt til</a>
        <a class="btn big" asp-controller="Prosjekter" asp-action="Index">Se alle prosjekter</a>
    </div>
</section>

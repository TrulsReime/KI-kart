@model OversiktViewModel
@{
    ViewData["Fane"] = "oversikt";
    ViewData["Title"] = "Oversikt";
}

<form class="herosearch" action="/Prosjekter" method="get" role="search">
    <label for="gq" class="eyebrow">Finn et prosjekt</label>
    <partial name="_Sokefelt" model='new SokefeltModel("gq", "Søk etter prosjektnavn, kommune eller stikkord")' />
</form>

@* 1. Nøkkeltall *@
<div class="statband">
    <a class="stat kbtn" asp-controller="Prosjekter" asp-action="Index">
        <div class="sv num">@Model.AntallProsjekter</div>
        <div class="sl">KI-prosjekter</div>
        <div class="sn">@Model.AntallIDrift i drift</div>
    </a>
    <div class="stat">
        <div class="sv num">@Model.AntallKommuner<small> av 25</small></div>
        <div class="sl">kommuner er med</div>
        <div class="sn">alene eller i samarbeid</div>
    </div>
    <a class="stat kbtn" asp-controller="Samarbeid" asp-action="Index">
        <div class="sv num">@Model.AntallSamarbeid</div>
        <div class="sl">samarbeidsprosjekter</div>
        <div class="sn">@Model.AntallApneSamarbeid er åpne for flere</div>
    </a>
    <a class="stat kbtn" asp-controller="Prosjekter" asp-action="Index">
        <div class="sv num">@Model.AntallNye</div>
        <div class="sl">nye siste 30 dager</div>
        <div class="sn">se de nyeste →</div>
    </a>
</div>

@* 2. Utvalgte prosjekter (karusell) og nye i kartet *@
<div class="spot">
    <section class="carousel" aria-roledescription="karusell" aria-label="Utvalgte prosjekter" data-karusell>
        <div class="slides" aria-live="off">
            @for (var i = 0; i < Model.Utvalgte.Count; i++)
            {
                var sp = Model.Utvalgte[i];
                var lenke = Lenker.Prosjekt(Context, sp.Id);
                <article class="spotcard slide@(i == 0 ? " on" : "")" aria-roledescription="lysbilde" aria-label="@(i + 1) av @Model.Utvalgte.Count: @sp.Tittel" aria-hidden="@(i == 0 ? "false" : "true")">
                    <div class="spot-top">
                        <span class="spot-label">★ Utvalgt av DigiAgder</span>
                        <partial name="_FasePill" model="sp" />
                        @if (sp.Samarbeid) { <span class="pill collab">Samarbeid · @sp.Deltakere.Count kommuner</span> }
                    </div>
                    <h2><a class="linkbtn" href="@lenke" tabindex="@(i == 0 ? null : "-1")">@sp.Tittel</a></h2>
                    <p class="spot-desc">@sp.Beskrivelse</p>
                    @if (sp.Gevinst != null)
                    {
                        <div class="spot-result"><span>Resultat</span><strong>@sp.Gevinst</strong></div>
                    }
                    @if (sp.Fungerte != null)
                    {
                        <blockquote class="spot-quote">«@sp.Fungerte»<cite>@sp.Kontakt.Navn, @sp.Kontakt.Rolle.ToLowerInvariant(), @sp.Eier</cite></blockquote>
                    }
                    <div class="spot-foot">
                        <div class="badges">
                            @foreach (var k in sp.Deltakere.Take(5))
                            {
                                <span class="kb" title="@k">@ProsjektLogikk.Initialer(k)</span>
                            }
                            @if (sp.Deltakere.Count > 5) { <span class="kb more">+@(sp.Deltakere.Count - 5)</span> }
                        </div>
                        <a class="btn primary" href="@lenke" tabindex="@(i == 0 ? null : "-1")">Les om prosjektet</a>
                    </div>
                </article>
            }
        </div>
        @if (Model.Utvalgte.Count > 1)
        {
            <div class="cnav">
                <div class="dots">
                    @for (var i = 0; i < Model.Utvalgte.Count; i++)
                    {
                        <button type="button" class="dot" aria-label="Vis @Model.Utvalgte[i].Tittel" aria-current="@(i == 0 ? "true" : "false")" data-til="@i"></button>
                    }
                </div>
                <button type="button" class="cbtn" aria-label="Pause" data-pause>❚❚</button>
            </div>
        }
    </section>

    <section class="panel newpanel">
        <h2>Nye i kartet</h2>
        <p class="sub">Disse kommunene har nylig delt prosjektene sine</p>
        <ul class="newlist">
            @foreach (var p in Model.Nyeste)
            {
                <li>
                    <span class="kb big" title="@p.Kommune">@ProsjektLogikk.Initialer(p.Kommune)</span>
                    <div>
                        <a class="linkbtn t" href="@Lenker.Prosjekt(Context, p.Id)">@p.Tittel</a>
                        <div class="what">@p.Eier · lagt inn @Datoformat.Lang(p.Registrert)</div>
                    </div>
                    @if (Datoformat.DagerSiden(p.Registrert, Model.Idag) <= 30) { <span class="pill new">Ny</span> }
                </li>
            }
        </ul>
        <a class="btn ghost small" asp-controller="Prosjekter" asp-action="Index">Se alle prosjekter →</a>
    </section>
</div>

@* 3. Kart, sist oppdatert og varsel. Kolonnene har lik høyde. *@
<div class="grid ov sym" style="margin-top:24px">
    <section class="panel">
        <h2>Prosjekter per kommune</h2>
        <p class="sub">Samarbeidsprosjekter teller i alle kommunene som er med. Klikk for å se prosjektene.</p>
        <partial name="_Kart" model="Model.Kart" />
    </section>
    <div class="stackcol">
        <section class="panel grow">
            <h2>Sist oppdatert</h2>
            <p class="sub">Hva som er endret, og når</p>
            <ul class="feed">
                @foreach (var p in Model.SistOppdatert)
                {
                    <li>
                        <div class="when akt @ProsjektLogikk.Aktualitetsstatus(p, Model.Idag).Klasse">@Datoformat.Kort(p.Oppdatert)</div>
                        <div>
                            <a class="linkbtn t" href="@Lenker.Prosjekt(Context, p.Id)">@p.Tittel</a>
                            <div class="what">@p.SistEndret · @p.Eier</div>
                        </div>
                    </li>
                }
            </ul>
        </section>
        <section class="panel" id="varsel">
            <h2>Få varsel om nye prosjekter</h2>
            <p class="sub">E-post når noen legger inn eller oppdaterer et prosjekt.</p>
            <form class="inlineform" asp-controller="Home" asp-action="Folg" method="post" novalidate>
                <input type="email" name="epost" placeholder="navn@kommune.no" aria-label="E-post for varsler" />
                <button class="btn teal" type="submit">Følg</button>
            </form>
        </section>
    </div>
</div>

@* 4. Fase og sektor, like brede og like høye *@
<div class="grid halves" style="margin-top:24px">
    <section class="panel">
        <h2>Fase</h2>
        <p class="sub">Klikk for å se prosjektene</p>
        <partial name="_Stolper" model="Model.Faser" />
    </section>
    <section class="panel">
        <h2>Sektor</h2>
        <p class="sub">Klikk for å se prosjektene</p>
        <partial name="_Stolper" model="Model.Sektorer" />
    </section>
</div>

@* 5. Oppfordring til å melde inn *@
<section class="cta prestige">
    <div class="cta-main">
        <div class="eyebrow" style="color:#8FD9F7">Vis frem det kommunen din får til</div>
        <h2>Bli en del av KI-kartet for Agder</h2>
        <p>Prosjektene i kartet blir sett av ledere, fagmiljøer og andre kommuner i hele regionen. Utvalgte prosjekter løftes frem her og i DigiAgders nettverk.</p>
        <ul class="cta-points">
            <li>Synlig for hele Agder</li>
            <li>Finn partnere som vil samarbeide</li>
            <li>Del erfaringer, også fra prosjekter som ble avbrutt</li>
        </ul>
    </div>
    <div class="cta-act">
        <a class="btn primary big outline-cta" asp-controller="MeldInn" asp-action="Index">+ Meld inn prosjekt</a>
        <span>Tar rundt fem minutter</span>
    </div>
</section>

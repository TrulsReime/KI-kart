@model ForvaltningViewModel
@{
    ViewData["Fane"] = "forvaltning";
    ViewData["Title"] = "Forvaltning";
}

<div class="adminhead">
    <div>
        <h2>Forvaltning av innmeldinger</h2>
        <p class="sub" style="margin:4px 0 0">For DigiAgder. Nye prosjekter, oppdateringer, rettelser og forespørsler om å bli med. Ingenting publiseres før det er godkjent.</p>
    </div>
    <span class="pill warn">Krever innlogging i ferdig løsning</span>
</div>

<div class="kpis" style="margin:16px 0">
    <div class="kpi"><div class="eyebrow">Til behandling</div><div class="value num">@Model.AntallNye</div></div>
    <div class="kpi"><div class="eyebrow">Venter på innsender</div><div class="value num">@Model.AntallVenter</div></div>
    <div class="kpi"><div class="eyebrow">Må bekreftes snart</div><div class="value num">@Model.Paminnelser.Count(x => !x.Inaktiv)</div></div>
    <div class="kpi"><div class="eyebrow">Inaktive</div><div class="value num" style="@(Model.Paminnelser.Any(x => x.Inaktiv) ? "color:var(--crit-ink)" : null)">@Model.Paminnelser.Count(x => x.Inaktiv)</div></div>
</div>

<nav class="segtabs" aria-label="Status">
    @foreach (var (v, l) in ForvaltningViewModel.Faner)
    {
        <a href="/Forvaltning?fane=@v" aria-current="@(Model.Fane == v ? "page" : null)">@l<span class="count">@Model.Antall(v)</span></a>
    }
</nav>

<section class="panel qpanel">
    @if (Model.Fane == "utvalgte")
    {
        var fulle = Model.Utvalgte.Count >= Katalog.MaksUtvalgte;
        <p class="sub" style="margin-top:0">Prosjektene her vises i karusellen på forsiden, i denne rekkefølgen. Du kan velge ut opptil @Katalog.MaksUtvalgte. Er ingen valgt ut, viser forsiden de nyeste prosjektene i stedet. Inaktive prosjekter vises ikke og bør byttes ut.</p>

        <h3 class="eyebrow" style="margin:14px 0 4px">Valgt ut nå (@Model.Utvalgte.Count av @Katalog.MaksUtvalgte)</h3>
        <ol class="alist">
            @for (var n = 0; n < Model.Utvalgte.Count; n++)
            {
                var r = Model.Utvalgte[n];
                var p = r.Prosjekt;
                <li>
                    <div>
                        <span class="num" style="font-weight:700;margin-right:8px">@(n + 1).</span><a class="linkbtn t" href="@Lenker.Prosjekt(Context, p.Id)">@p.Tittel</a>
                        <div class="w">@p.Eier · @p.Fase</div>
                        @if (r.Inaktiv)
                        {
                            <div class="w" style="color:var(--crit-ink);font-weight:600">Inaktivt, vises ikke på forsiden. Bytt det ut eller be eieren bekrefte det.</div>
                        }
                    </div>
                    <div style="display:flex;gap:6px">
                        <form asp-action="FlyttUtvalgt" asp-route-id="@p.Id" asp-route-retning="-1" method="post">
                            <button class="btn small" type="submit" disabled="@(n == 0)" aria-label="Flytt @p.Tittel opp">↑</button>
                        </form>
                        <form asp-action="FlyttUtvalgt" asp-route-id="@p.Id" asp-route-retning="1" method="post">
                            <button class="btn small" type="submit" disabled="@(n == Model.Utvalgte.Count - 1)" aria-label="Flytt @p.Tittel ned">↓</button>
                        </form>
                        <form asp-action="FjernUtvalgt" asp-route-id="@p.Id" method="post">
                            <button class="btn small" type="submit" aria-label="Fjern @p.Tittel fra karusellen">Fjern</button>
                        </form>
                    </div>
                </li>
            }
            @if (Model.Utvalgte.Count == 0)
            {
                <li><span class="muted">Ingen er valgt ut. Forsiden viser de nyeste prosjektene.</span></li>
            }
        </ol>

        <h3 class="eyebrow" style="margin:22px 0 6px">Velg ut flere</h3>
        <form method="get" action="/Forvaltning" role="search" style="margin-bottom:6px">
            <input type="hidden" name="fane" value="utvalgte" />
            <div class="searchbox">
                @Ikoner.Sok
                <input name="q" type="search" value="@Model.Sok" placeholder="Søk etter prosjekt, kommune eller stikkord" aria-label="Søk etter prosjekter som kan velges ut" />
            </div>
        </form>
        @if (fulle)
        {
            <p class="hint" style="margin:6px 0">Karusellen er full. Fjern et prosjekt for å velge ut et annet.</p>
        }
        <ul class="alist">
            @foreach (var p in Model.Kandidater)
            {
                <li>
                    <div>
                        <a class="linkbtn t" href="@Lenker.Prosjekt(Context, p.Id)">@p.Tittel</a>
                        <div class="w">@p.Eier · @p.Fase · oppdatert @Datoformat.Kort(p.Oppdatert)@(p.HarErfaringer ? " · har erfaringer" : "")</div>
                    </div>
                    <form asp-action="VelgUt" asp-route-id="@p.Id" asp-route-q="@Model.Sok" method="post">
                        <button class="btn small" type="submit" disabled="@fulle">Velg ut</button>
                    </form>
                </li>
            }
            @if (Model.Kandidater.Count == 0)
            {
                <li><span class="muted">@(string.IsNullOrWhiteSpace(Model.Sok) ? "Ingen flere publiserte prosjekter." : "Ingen prosjekter passer søket.")</span></li>
            }
        </ul>
    }
    else if (Model.Fane == "pam")
    {
        <p class="sub" style="margin-top:0">Prosjekteieren får en påminnelse etter @ProsjektLogikk.MndPaminnelse måneder uten oppdatering. Bekreftes ikke prosjektet innen @ProsjektLogikk.MndInaktiv måneder, blir det inaktivt og skjules fra oversikten. I ferdig løsning sendes påminnelsen automatisk. Her kan du også sende den manuelt, for eksempel til eiere av inaktive prosjekter.</p>
        @foreach (var (tittel, inaktive) in new[] { ("Inaktive prosjekter", true), ("Må bekreftes snart", false) })
        {
            var rader = Model.Paminnelser.Where(r => r.Inaktiv == inaktive).ToList();
            <h3 class="eyebrow" style="margin:14px 0 4px">@tittel (@rader.Count)</h3>
            <ul class="alist">
                @foreach (var r in rader)
                {
                    var p = r.Prosjekt;
                    var sendt = p.PaminnelseSendt;
                    <li>
                        <div>
                            <a class="linkbtn t" href="@Lenker.Prosjekt(Context, p.Id)">@p.Tittel</a>
                            <div class="w"><span class="akt @r.Aktualitet.Klasse">@r.Aktualitet.Tekst</span> · eier @p.Eierperson.Navn@(sendt is DateOnly d ? $" · påminnelse sendt {Datoformat.Kort(d)}" : "")</div>
                        </div>
                        <form asp-action="Paminnelse" asp-route-id="@p.Id" method="post">
                            <button class="btn small" type="submit">@(sendt != null ? "Send på nytt" : "Send påminnelse")</button>
                        </form>
                        <details style="grid-column:1/-1">
                            <summary style="font-size:12.5px;color:var(--ink-3);cursor:pointer">Se e-posten</summary>
                            <div class="mail">@r.Epost</div>
                        </details>
                    </li>
                }
                @if (rader.Count == 0)
                {
                    <li><span class="muted">Ingen.</span></li>
                }
            </ul>
        }
    }
    else
    {
        @if (Model.Rader.Count == 0)
        {
            <div class="empty">@(Model.Fane == "ny" ? "Ingen nye innmeldinger. Bra jobbet!" : "Ingenting her.")</div>
        }
        @foreach (var r in Model.Rader)
        {
            var i = r.Innmelding;
            var p = r.Prosjekt;
            <details class="qrow" open="@(Model.ApenId == i.Id)">
                <summary>
                    <div class="qmain">
                        <div class="qkind">@i.TypeTekst</div>
                        <div class="qtitle">@p.Tittel</div>
                        <div class="w">@i.Fra · sendt @Datoformat.Lang(i.Dato)</div>
                    </div>
                    <span class="pill @i.StatusKlasse">@i.StatusTekst</span>
                </summary>
                <div class="qbody">
                    @if (i.Type == InnmeldingType.NyttProsjekt)
                    {
                        <dl class="kv">
                            <dt>Ansvarlig</dt><dd>@p.Eier</dd>
                            <dt>Organisering</dt><dd>@(p.Samarbeid ? "Samarbeid: " + string.Join(", ", p.Deltakere) : "Én kommune")</dd>
                            <dt>IKT-samarbeid</dt><dd>@(p.IktSamarbeid.Count > 0 ? string.Join(", ", p.IktSamarbeid) : "Ikke oppgitt")</dd>
                            <dt>Sektor og fase</dt><dd>@p.Sektor · @p.Fase</dd>
                            <dt>Hva løsningen gjør</dt><dd>@p.Beskrivelse</dd>
                            <dt>Stikkord</dt><dd>@string.Join(" ", p.Stikkord.Select(t => "#" + t))</dd>
                            <dt>Kontakt</dt><dd>@p.Kontakt.Navn (@(string.IsNullOrEmpty(p.Kontakt.Rolle) ? "rolle ikke oppgitt" : p.Kontakt.Rolle)), @p.Kontakt.Epost</dd>
                        </dl>
                        @if (r.MuligeDuplikater.Count > 0)
                        {
                            <div class="qwarn">Mulig duplikat:
                                @for (var n = 0; n < r.MuligeDuplikater.Count; n++)
                                {
                                    var b = r.MuligeDuplikater[n];
                                    @(n > 0 ? ", " : "")<a class="linkbtn ul" href="@Lenker.Prosjekt(Context, b.Id)">@b.Tittel</a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p style="margin:0 0 6px">@(i.Type == InnmeldingType.BliMed ? $"{i.Kommune} vil bli med i prosjektet. «{i.Tekst}»" : i.Tekst)</p>
                        <a class="linkbtn ul" href="@Lenker.Prosjekt(Context, p.Id)">Åpne prosjektet slik det ser ut nå</a>
                    }
                    @if (i.Kommentar != null)
                    {
                        <div class="qnote"><strong>@(i.Status == InnmeldingStatus.Avvist ? "Begrunnelse: " : "Melding til innsender: ")</strong>@i.Kommentar</div>
                    }
                    @if (i.KanBehandles)
                    {
                        <form class="qactions" asp-action="Behandle" asp-route-id="@i.Id" method="post">
                            <input type="hidden" name="fane" value="@Model.Fane" />
                            <textarea name="melding" rows="2" class="qmsg" aria-label="Melding til innsender" placeholder="Melding til innsender (påkrevd ved «Be om endring» og «Avvis»)"></textarea>
                            <div class="qbtns">
                                <button class="btn primary" type="submit" name="handling" value="godkjenn">@(i.Type switch { InnmeldingType.NyttProsjekt => "Godkjenn og publiser", InnmeldingType.BliMed => "Legg til kommunen", _ => "Godkjenn endringen" })</button>
                                <button class="btn" type="submit" name="handling" value="endring">Be om endring</button>
                                <button class="btn danger" type="submit" name="handling" value="avvis">Avvis</button>
                            </div>
                        </form>
                    }
                    else if (i.BehandletDato is DateOnly bd)
                    {
                        <p class="sub" style="margin:8px 0 0">@i.StatusTekst @Datoformat.Lang(bd)</p>
                    }
                </div>
            </details>
        }
    }
</section>

@if (Model.Henvendelser.Count > 0)
{
    <section class="panel" style="margin-top:16px">
        <h2>Samarbeidshenvendelser</h2>
        <p class="sub">Viser at kartet blir brukt. Kan brukes som suksessmål.</p>
        <ul class="alist">
            @foreach (var h in Model.Henvendelser)
            {
                <li>
                    <div><div class="t">@h.ProsjektTittel</div><div class="w">Fra @h.Henvendelse.Fra · @h.Henvendelse.Melding</div></div>
                    <span class="muted" style="font-size:12.5px">@Datoformat.Lang(h.Henvendelse.Dato)</span>
                </li>
            }
        </ul>
    </section>
}

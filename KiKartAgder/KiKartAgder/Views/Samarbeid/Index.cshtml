@model SamarbeidViewModel
@{
    ViewData["Fane"] = "samarbeid";
    ViewData["Title"] = "Samarbeid";
    var a = Model.Valgt;
}

<section class="panel why">
    <h2 style="font-size:20px">Hvorfor samarbeide?</h2>
    <p class="sub">@Model.AntallKommunerISamarbeid av 25 kommuner er med i minst ett samarbeid. Dette går igjen i erfaringene deres:</p>
    <div class="benefits onwhite">
        <div class="ben"><span class="bi">@Ikoner.Ikon("check")</span><div><strong>Én vurdering i stedet for mange</strong><span>Personvern og sikkerhet vurderes én gang for alle kommunene som er med.</span></div></div>
        <div class="ben"><span class="bi">@Ikoner.Ikon("people")</span><div><strong>Delte kostnader</strong><span>Opplæring, lisenser og innleid hjelp blir billigere per kommune.</span></div></div>
        <div class="ben"><span class="bi">@Ikoner.Ikon("bulb")</span><div><strong>Lær av dem som har gjort det</strong><span>Små kommuner får tilgang til kompetanse de ikke har selv.</span></div></div>
    </div>
</section>

<section class="panel" style="margin-top:16px">
    <div class="why-head">
        <div>
            <h2>Samarbeidsprosjekter</h2>
            <p class="sub">@Model.Samarbeidsprosjekter.Count prosjekter der flere kommuner er med. Alle kan be om å bli med i prosjekter som er åpne.</p>
        </div>
    </div>
    <div class="colgrid">
        @foreach (var p in Model.Samarbeidsprosjekter)
        {
            var vis = p.Deltakere.Take(5).ToList();
            var resten = p.Deltakere.Count - vis.Count;
            <article class="colcard">
                <div class="c-top">
                    <div class="c-pills">
                        <partial name="_FasePill" model="p" />
                        @if (p.ErApenForFlere) { <span class="pill ok">Åpent for flere</span> }
                    </div>
                    <span class="upd">@p.Deltakere.Count kommuner</span>
                </div>
                <h3><a class="linkbtn" href="@Lenker.Prosjekt(Context, p.Id)">@p.Tittel</a></h3>
                <div class="members">
                    @for (var i = 0; i < vis.Count; i++)
                    {
                        <span class="mem@(i == 0 ? " lead" : "")">@vis[i]</span>
                    }
                    @if (resten > 0) { <span class="mem more">+@resten</span> }
                </div>
                <div class="colfoot">
                    @if (p.ErApenForFlere)
                    {
                        <a class="btn teal small" href="@(Lenker.Prosjekt(Context, p.Id, "blimed"))#blimed">Bli med</a>
                    }
                    else
                    {
                        <span></span>
                    }
                    <a class="btn ghost small" href="@Lenker.Prosjekt(Context, p.Id)">Se prosjektet →</a>
                </div>
            </article>
        }
    </div>
</section>

<div class="grid collab" style="margin-top:16px" id="partner">
    <section class="panel">
        <h2>Finn en partner</h2>
        <p class="sub">@Model.SerEtterNoe.Count prosjekter ser etter noe. Velg ett for å se hvem som passer.</p>
        <div class="need-list">
            @foreach (var p in Model.SerEtterNoe)
            {
                <a class="need" href="/Samarbeid?valgt=@p.Id#partner" aria-current="@(p.Id == a?.Id ? "true" : null)">
                    <div class="t">@p.Tittel</div>
                    <div class="o">@p.Eier</div>
                    <div class="o seekline">Ser etter: @string.Join(", ", p.Soker).ToLowerInvariant()</div>
                </a>
            }
        </div>
    </section>
    <section class="panel">
        @if (a != null)
        {
            <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-bottom:12px;border-bottom:1px solid var(--line)">
                <div>
                    <div class="sub" style="margin:0">Disse kan passe for</div>
                    <h2 style="font-size:19px">@a.Tittel</h2>
                    <div class="o seekline" style="margin-top:4px">Ser etter: @string.Join(", ", a.Soker).ToLowerInvariant()</div>
                </div>
                <a class="btn small" href="@Lenker.Prosjekt(Context, a.Id)">Se prosjektet</a>
            </div>
            @if (Model.Treff.Count == 0)
            {
                <div class="empty">Fant ingen gode treff ennå.</div>
            }
            @foreach (var t in Model.Treff)
            {
                var b = t.Prosjekt;
                <div class="match nos">
                    <div>
                        <div class="mhead">
                            <h3><a class="linkbtn" href="@Lenker.Prosjekt(Context, b.Id)">@b.Tittel</a></h3>
                            <partial name="_FasePill" model="b" />
                        </div>
                        <div class="muted" style="font-size:13.5px">@(b.Samarbeid ? $"{b.Eier} + {b.Deltakere.Count - 1} kommuner" : b.Eier)</div>
                        <p class="mwhy">@(string.Join(". ", t.Grunner.Take(2))).</p>
                        <div class="mfoot">
                            <span><strong>@b.Kontakt.Navn</strong>, @b.Kontakt.Rolle.ToLowerInvariant()</span>
                            <span class="mact">
                                <button class="btn small" type="button" data-kopier="@b.Kontakt.Epost">Kopier e-post</button>
                                <a class="btn ghost small" href="@Lenker.Prosjekt(Context, b.Id)">Se prosjektet →</a>
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty">Ingen prosjekter ser etter partnere akkurat nå.</div>
        }
    </section>
</div>
